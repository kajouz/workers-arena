# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://ka@localhost:5432/workers_arena_v2?schema=public"
DEMO_MODE="true"

# ---- Auth.js (NextAuth v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3001"
# Optional OAuth provider (mounted only when both are set):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Real mode = DEMO_MODE=false + DATABASE_URL + a real AUTH_SECRET:
#   npx prisma migrate deploy && npm run db:seed
# Seeded demo accounts sign in with password "Password123!" (see prisma/seed.ts).

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WorkersArena"

# ---- Payments (production only) ----
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# MYFATOORAH_API_TOKEN=
# TAP_SECRET_KEY=

# ---- Cloudinary (production only) ----
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Redis (production only) ----
# REDIS_URL="redis://localhost:6379"

# ---- Notifications: outbound channels (email + push) ----
# In demo mode the console providers log every dispatch; set these to enable
# real delivery. Providers are lazy-loaded, so no SDKs are required until used.
#
# Email: console | smtp (nodemailer) | resend
# NOTIFY_EMAIL_ENABLED="true"
# NOTIFY_EMAIL_PROVIDER="smtp"
# NOTIFY_SMTP_HOST="smtp.example.com"
# NOTIFY_SMTP_PORT="587"
# NOTIFY_SMTP_USER=""
# NOTIFY_SMTP_PASS=""
# NOTIFY_MAIL_FROM="WorkersArena <no-reply@workersarena.com>"
# RESEND_API_KEY=""
#
# Push: console | web-push (requires VAPID keys + a registered subscription)
# NOTIFY_PUSH_ENABLED="true"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@workersarena.com"
#
# Cron guard for GET /api/cron/reminders (subscription expiry reminders)
# CRON_SECRET="replace-with-a-long-random-secret"
