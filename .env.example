# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://ka@localhost:5432/workers_arena_v2?schema=public"
DEMO_MODE="true"

# ---- Auth.js (NextAuth v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3001"
#
# Guest phone OTP (docs/ENHANCEMENT-PLAN.md — guest phone OTP):
#   OTP_HASH_SECRET     HMAC key for stored code hashes (generate: openssl rand -hex 32)
#   GUEST_OTP_ENFORCED  true -> guest booking/quote/recurring writes require a
#                       verified code. Default off (dormant) so seeded/nightly
#                       real-mode flows keep passing; flip in production once
#                       NOTIFY_SMS_PROVIDER is a real gateway.
# OTP_HASH_SECRET="replace-with-a-long-random-hex-32"
# GUEST_OTP_ENFORCED="false"
# Optional OAuth provider (mounted only when both are set):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Real mode = DEMO_MODE=false + DATABASE_URL + a real AUTH_SECRET:
#   npx prisma migrate deploy && npm run db:seed
# Seeded demo accounts sign in with password "Password123!" (see prisma/seed.ts).

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WorkersArena"

# ---- Payments (production only) ----
# PAYMENT_SIM_SECRET is the HMAC key for simulated/manual payment URLs. In prod
# (DEMO_MODE=false) it MUST be set to a random 32+ char value or the app will
# fail to boot — the fallback "sim-dev-secret" is dev/demo only (C4).
# Generate: openssl rand -hex 32
# PAYMENT_SIM_SECRET="replace-with-a-long-random-hex-32"
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# MYFATOORAH_API_TOKEN=
# TAP_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Cloudinary (production only) ----
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Redis / Rate limiting (production) ----
# Distributed rate limiting (M3) uses Upstash Redis REST (edge-compatible). Set
# both for production; otherwise rate limiting falls back to per-instance in-memory.
# Vercel Marketplace → Upstash Redis → copy REST URL + token. Generate local:
# https://console.upstash.com/redis → Create → REST API
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"
# Fallback / local: REDIS_URL="redis://localhost:6379" (in-memory fallback on edge)
# REDIS_URL="redis://localhost:6379"

# ---- Notifications: outbound channels (email + push) ----
# In demo mode the console providers log every dispatch; set these to enable
# real delivery. Providers are lazy-loaded, so no SDKs are required until used.
#
# Email: console | smtp (nodemailer) | resend
# NOTIFY_EMAIL_ENABLED="true"
# NOTIFY_EMAIL_PROVIDER="smtp"
# NOTIFY_SMTP_HOST="smtp.example.com"
# NOTIFY_SMTP_PORT="587"
# NOTIFY_SMTP_USER=""
# NOTIFY_SMTP_PASS=""
# NOTIFY_MAIL_FROM="WorkersArena <no-reply@workersarena.com>"
# RESEND_API_KEY=""
#
# Push: console | web-push (requires VAPID keys + a registered subscription)
# Generate: npx web-push generate-vapid-keys
# NOTIFY_PUSH_ENABLED="true"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@workersarena.com"
#
# Cron guard for ALL /api/cron/* routes (reminders, recurring, completions, etc.)
# Accepts either `x-cron-secret` header or `Authorization: Bearer <secret>`.
# If unset, every cron route returns 401. Generate: openssl rand -hex 32
# CRON_SECRET="replace-with-a-long-random-hex-32"

# ---- Monitoring (Sentry) ----
# Create a project at https://sentry.io → Settings → Client Keys (DSN)
# SENTRY_DSN="https://xxx@sentry.io/xxx"           # Server-side DSN
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx" # Client-side DSN
# SENTRY_ENVIRONMENT="production"
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="workers-arena"
# SENTRY_AUTH_TOKEN="sntrys_xxx"                    # For source map uploads
