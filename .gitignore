# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db

# demo push-subscription registry
.data/

# freebuff runtime (keep run.md + daemonize.mjs)
.freebuff/*.log
.freebuff/desktop-v2.db*

# local scratch (e.g. isolated NEXT_DIST_DIR build dirs — see next.config.ts)
/tmp/

# meilisearch runtime data
meili_data/

# launchd plists (local dev only)
.freebuff/*.plist
.freebuff/com.workersarena.*

# Capacitor native platforms (regenerate with npx cap add + npx cap sync)
/ios/
/android/
/out/

# Backup files written at the repo root (a stray dumps directory).
# ANCHORED on purpose: an unanchored `backups/` also matches every backups/
# directory anywhere in the tree — including the admin route
# src/app/[locale]/(app)/admin/backups/, which silently kept that whole page
# out of version control (the route 404s on any fresh checkout / deploy).
/backups/

# Playwright artifacts
test-results/
playwright-report/
.env.production

# Vercel CLI writes a short-lived OIDC token here (`vercel env pull`, `vercel dev`).
# It was committed once already — never again.
.env.vercel
