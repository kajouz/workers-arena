#!/bin/sh
#
# Pre-commit hook: run type checking + unit tests
# Only runs on staged .ts/.tsx files to keep it fast.
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo ""
echo "${YELLOW}🔍 Pre-commit checks running...${NC}"
echo ""

# ── 1. Check if any TypeScript files are staged ──────────────────────
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -z "$STAGED_TS" ]; then
  echo "${GREEN}✅ No TypeScript files staged — skipping checks.${NC}"
  exit 0
fi

echo "${YELLOW}Staged TypeScript files:${NC}"
echo "$STAGED_TS" | head -10
echo ""

# ── 2. TypeScript type check ────────────────────────────────────────
echo "${YELLOW}⏳ Running TypeScript type check...${NC}"
if npx tsc --noEmit 2>&1; then
  echo "${GREEN}✅ TypeScript: no errors${NC}"
else
  echo "${RED}❌ TypeScript errors found — commit blocked.${NC}"
  echo "${YELLOW}Fix the errors above and try again.${NC}"
  exit 1
fi

# ── 3. Unit tests (exclude e2e and prisma tests) ────────────────────
echo ""
echo "${YELLOW}⏳ Running unit tests...${NC}"
if npx vitest run \
  --exclude '**/e2e-*.test.ts' \
  --exclude '**/*-prisma.test.ts' \
  --reporter=verbose 2>&1 | tail -20; then
  echo "${GREEN}✅ All unit tests passed${NC}"
else
  echo "${RED}❌ Unit tests failed — commit blocked.${NC}"
  echo "${YELLOW}Fix the failing tests and try again.${NC}"
  exit 1
fi

echo ""
echo "${GREEN}🎉 All pre-commit checks passed!${NC}"
echo ""
