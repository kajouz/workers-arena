#!/bin/sh
#
# Pre-push hook: run the quick e2e suite (dev build only) to catch
# regressions before they reach main. Skips the prod build leg (~2 min)
# to keep the push flow fast. Use git push --no-verify to bypass.
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "${YELLOW}🔍 Pre-push: running quick e2e suite (dev build only)...${NC}"
echo ""

# Run the quick e2e suite — skips the prod build leg. Output goes to a file
# rather than through `| tail`, so the exit status is vitest's, not tail's
# (${PIPESTATUS[0]} is a bash-ism and a fatal "Bad substitution" under dash).
E2E_LOG=$(mktemp)
trap 'rm -f "$E2E_LOG"' EXIT
EXIT_CODE=0
E2E_SKIP_PROD=1 npx vitest run tests/e2e-smoke.test.ts --reporter=verbose >"$E2E_LOG" 2>&1 || EXIT_CODE=$?
tail -20 "$E2E_LOG"

if [ "$EXIT_CODE" -eq 0 ]; then
  echo ""
  echo "${GREEN}✅ Pre-push e2e passed${NC}"
  exit 0
else
  echo ""
  echo "${RED}❌ Pre-push e2e failed (vitest exit $EXIT_CODE) — push blocked.${NC}"
  echo "${YELLOW}Use git push --no-verify to bypass.${NC}"
  exit 1
fi
